<div {{ $attributes->merge(['style' => 'display: flex; align-items: center; gap: 0.75rem;']) }}>
    <!-- SVG Icon: Two overlapping isometric shipping boxes -->
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <defs>
            <linearGradient id="cyanGradBox" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00d9ff" />
                <stop offset="100%" stop-color="#0066ff" />
            </linearGradient>
            <linearGradient id="magentaGradBox" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff00ff" />
                <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
        </defs>
        
        <!-- Background Box (Magenta) -->
        <g style="transform: translate(1px, 2px);">
            <path d="M22 13l-6-3-6 3v6l6 3 6-3v-6z" stroke="url(#magentaGradBox)"></path>
            <polyline points="10 13 16 16 22 13" stroke="url(#magentaGradBox)"></polyline>
            <line x1="16" y1="16" x2="16" y2="22" stroke="url(#magentaGradBox)"></line>
        </g>

        <!-- Foreground Box (Cyan) overlapping the other -->
        <g style="transform: translate(-1px, -2px);">
            <!-- Background fill to hide lines of the box behind it -->
            <path d="M14 8l-6-3-6 3v6l6 3 6-3V8z" fill="#0a0e27" stroke="none"></path>
            
            <path d="M14 8l-6-3-6 3v6l6 3 6-3V8z" stroke="url(#cyanGradBox)"></path>
            <polyline points="2 8 8 11 14 8" stroke="url(#cyanGradBox)"></polyline>
            <line x1="8" y1="11" x2="8" y2="17" stroke="url(#cyanGradBox)"></line>
            
            <!-- Small Swap Arrows on the front face of the Cyan Box -->
            <path d="M5 12l2 1m0 0l-2 1m2-1H5" stroke="#00d9ff" stroke-width="1"></path>
            <path d="M11 15l-2-1m0 0l2-1m-2 1h2" stroke="#00d9ff" stroke-width="1"></path>
        </g>
    </svg>
    <!-- Brand Name -->
    <span style="font-size: 1.75rem; font-family: var(--font-display); font-weight: 800; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.02em;">
        SwapShip
    </span>
</div>
