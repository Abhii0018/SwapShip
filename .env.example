APP_NAME=SwapShip
# IMPORTANT: keep production with APP_DEBUG=false and APP_ENV=production. Debug=true on prod is a major perf and security issue.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use warning on prod to keep noise down; debug only for local.
LOG_LEVEL=warning

# For local pgsql:    DB_CONNECTION=pgsql, DB_PORT=5432
# For Render Postgres: copy the External Database URL fields here and set DB_SSLMODE=require.
# pgAdmin: register a new server using these same values (Connection tab) and add 'sslmode=require' under Parameters.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# On Render/production use database (NOT file) so OTP signup survives redirects.
SESSION_DRIVER=database
# Minutes of idle time before session expires (120 = 2 hours).
SESSION_LIFETIME=720
# True forces logout when browser closes (the session cookie becomes a session cookie, not persistent).
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Absolute session lifetime in minutes. Logged-in user is forced to re-auth this long after first login,
# regardless of activity polling. 720 = 12 hours.
ABSOLUTE_SESSION_LIFETIME=720

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: smtp (Gmail app password). Render: use SendGrid API (Gmail SMTP is blocked).
MAIL_MAILER=smtp
SENDGRID_API_KEY=
MAIL_TIMEOUT=8
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENT_GATEWAY=razorpay
PLATFORM_FEE_PERCENT=2.5
PLATFORM_FEE_FLAT=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPPING_DEFAULT_PROVIDER=mock
SHIPPING_WEBHOOK_TOKEN=
MOCK_SHIPPING_TRACKING_BASE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
